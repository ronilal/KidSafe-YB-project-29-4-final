    def on_child_select(self, child_name):
        """Handle child selection change"""
        self.current_child = child_name
        self.update_time_display()

    def update_time_display(self):
        """Update the time display based on the selected child"""
        # Get child data
        if self.current_child not in self.child_time_data:
            # Set default values if no data exists yet
            self.child_time_data[self.current_child] = {
                "limit_hours": 2,
                "limit_minutes": 30,
                "used_hours": 0,
                "used_minutes": 0,
                "connected": False
            }

        child_data = self.child_time_data[self.current_child]

        # Calculate total minutes for limit and used
        limit_hours = child_data.get("limit_hours", 2)
        limit_minutes = child_data.get("limit_minutes", 30)
        used_hours = child_data.get("used_hours", 0)
        used_minutes = child_data.get("used_minutes", 0)

        limit_total_minutes = (limit_hours * 60) + limit_minutes
        used_total_minutes = (used_hours * 60) + used_minutes

        # Calculate remaining time
        remaining_minutes = max(0, limit_total_minutes - used_total_minutes)
        remaining_hours = remaining_minutes // 60
        remaining_mins = remaining_minutes % 60

        # Update progress bar
        if limit_total_minutes > 0:
            progress = min(1.0, used_total_minutes / limit_total_minutes)
        else:
            progress = 0

        self.progress_bar.set(progress)

        # Update labels
        self.limit_display.configure(
            text=f"Daily Time Limit: {limit_hours}h {limit_minutes}m")
        self.used_label.configure(
            text=f"Used: {used_hours}h {used_minutes}m")
        self.remaining_label.configure(
            text=f"Remaining: {remaining_hours}h {remaining_mins}m")

        # Update entry fields - clear and insert new values
        self.hours_entry.delete(0, 'end')
        self.hours_entry.insert(0, str(limit_hours))

        self.minutes_entry.delete(0, 'end')
        self.minutes_entry.insert(0, str(limit_minutes))

        # Add connection status if available
        connected = child_data.get("connected", False)
        if connected:
            self.limit_display.configure(text=f"Daily Time Limit: {limit_hours}h {limit_minutes}m (Child is Connected)")
        else:
            self.limit_display.configure(
                text=f"Daily Time Limit: {limit_hours}h {limit_minutes}m (Child is Disconnected)")

    def set_time_limit(self):
        """Set a new time limit and send to server"""
        try:
            # Get values directly from entry widgets
            hours = int(self.hours_entry.get())
            minutes = int(self.minutes_entry.get())
            child = self.current_child

            if child == "No children":
                messagebox.showwarning("Warning", "No child selected.")
                return

            # Validate input
            if hours < 0 or minutes < 0 or minutes > 59:
                messagebox.showwarning("Warning", "Please enter valid hours and minutes.")
                return

            # Calculate total minutes
            total_minutes = hours * 60 + minutes

            # Send request to server
            request = {
                "code": "set_time_limit",
                "child": child,
                "time_limit": total_minutes
            }

            data = pickle.dumps(request)
            data = self.AESenc(data)
            send_with_size(self.sock, data)

            # Update local data
            if child in self.child_time_data:
                self.child_time_data[child]["limit_hours"] = hours
                self.child_time_data[child]["limit_minutes"] = minutes
            else:
                self.child_time_data[child] = {
                    "limit_hours": hours,
                    "limit_minutes": minutes,
                    "used_hours": 0,
                    "used_minutes": 0
                }

            # Update the display
            self.update_time_display()

            # Show confirmation
            messagebox.showinfo("Success", f"Time limit set to {hours}h {minutes}m for {child}")

        except ValueError:
            messagebox.showwarning("Error", "Please enter valid numbers for hours and minutes")
        except Exception as e:
            messagebox.showerror("Error", f"An error occurred: {str(e)}")

