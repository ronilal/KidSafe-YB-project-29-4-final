    # Action methods

    def get_app_names(self):
        """Request app list from server"""
        try:
            # Send request to server
            get_arr_dict = {
                "code": 'get_app_list',
                "user": self.username,
            }
            answer_dict = self.send_direct_request(get_arr_dict)

            if answer_dict['status'] == True:
                apps = answer_dict['apps']
                print(f'apps = {apps}')
                # Clear current list
                for widget in self.blocked_apps_widgets:
                    widget["frame"].destroy()
                self.blocked_apps_widgets = []

                # Add apps to list
                for app in apps:
                    self.add_app_to_list(app)

                return apps
            else:
                print(f"Error loading apps: {answer_dict.get('message', 'Unknown error')}")
                return []
        except Exception as e:
            print(f"Error getting app names: {e}")
            return []

    def add_blocked_app(self):
        """Add an app to the blocked list"""
        app_name = self.app_entry.get()
        if app_name:
            try:
                # Send request to server
                request = {
                    "code": "block_app",
                    "username": self.username,
                    "app_name": app_name
                }

                data = pickle.dumps(request)
                data = self.AESenc(data)
                send_with_size(self.sock, data)

                # Add to local list (server will confirm)
                self.add_app_to_list(app_name)
                self.app_entry.delete(0, 'end')
                messagebox.showinfo("Success", f"App {app_name} added to blocked list")

            except Exception as e:
                messagebox.showerror("Error", f"Failed to communicate with server: {e}")
        else:
            messagebox.showwarning("Error", "Please enter an application name")

    def remove_blocked_app(self, app_name, frame):
        """Remove an app from the blocked list"""
        try:
            # Send request to server
            request = {
                "code": "unblock_app",
                "username": self.username,
                "app_name": app_name
            }

            data = pickle.dumps(request)
            data = self.AESenc(data)
            send_with_size(self.sock, data)

            # Remove from local list
            frame.destroy()
            self.blocked_apps_widgets = [w for w in self.blocked_apps_widgets if w["name"] != app_name]
            messagebox.showinfo("Success", f"App {app_name} removed from blocked list")

        except Exception as e:
            messagebox.showerror("Error", f"Failed to communicate with server: {e}")

    def get_domain_names(self):
        """Get the list of blocked domains from server"""
        try:
            # Send request to server
            get_arr_dict = {
                "code": 'get_domains_list',
                "user": self.username,
            }
            answer_dict = self.send_direct_request(get_arr_dict)

            if answer_dict['status'] == True:
                domains = answer_dict['domains']

                # Clear current list
                for widget in self.blocked_websites_widgets:
                    widget["frame"].destroy()
                self.blocked_websites_widgets = []

                # Add domains to list
                for domain in domains:
                    self.add_website_to_list(domain)

                return domains
            else:
                print(f"Error loading domains: {answer_dict.get('message', 'Unknown error')}")
                return []
        except Exception as e:
            print(f"Error getting domain names: {e}")
            return []

    def add_blocked_domain(self):
        """Add a domain to the blocked list"""
        domain = self.website_entry.get()
        if domain:
            try:
                # Send request to server
                request = {
                    "code": "block_domain",
                    "username": self.username,
                    "domain": domain
                }

                data = pickle.dumps(request)
                data = self.AESenc(data)
                send_with_size(self.sock, data)

                # Add to local list (server will confirm)
                self.add_website_to_list(domain)
                self.website_entry.delete(0, 'end')
                messagebox.showinfo("Success", f"Domain {domain} added to blocked list")

            except Exception as e:
                messagebox.showerror("Error", f"Failed to communicate with server: {e}")
        else:
            messagebox.showwarning("Error", "Please enter a domain name")

    def remove_blocked_domain(self, domain, frame):
        """Remove a domain from the blocked list"""
        try:
            # Send request to server
            request = {
                "code": "unblock_domain",
                "username": self.username,
                "domain": domain
            }

            data = pickle.dumps(request)
            data = self.AESenc(data)
            send_with_size(self.sock, data)

            # Remove from local list
            frame.destroy()
            self.blocked_websites_widgets = [w for w in self.blocked_websites_widgets if w["name"] != domain]
            messagebox.showinfo("Action Completed", f"Domain {domain} removed from blocked list")

        except Exception as e:
