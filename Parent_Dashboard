        self.listening_thread.daemon = True
        self.listening_thread.start()

    def send_direct_request(self, request_dict):
        """שולח בקשה ישירה לשרת וממתין לתשובה, תוך השהיית תרד ההאזנה"""
        try:
            # השהה את תרד ההאזנה
            self.pause_listening = True
            time.sleep(0.2)  # המתן שהתרד יפסיק להאזין

            # שלח את הבקשה
            data = pickle.dumps(request_dict)
            data = self.AESenc(data)
            send_with_size(self.sock, data)

            # קבל את התשובה ישירות
            data = recv_by_size(self.sock, return_type='byte')
            response_data = self.AESdec(data)
            response = pickle.loads(response_data)

            # החזר את תרד ההאזנה לפעולה
            self.pause_listening = False

            return response
        except Exception as e:
            print(f"Error in direct request: {e}")
            # ודא שתרד ההאזנה מופעל מחדש גם במקרה של שגיאה
            self.pause_listening = False
            return None

    def listen_to_server(self):
        """Listen for messages from the server"""
        while not self.stop_listening:
            try:
                # אם ההאזנה מושהית זמנית, המתן קצת ונסה שוב
                if self.pause_listening:
                    time.sleep(0.1)
                    continue

                encrypted_data = recv_by_size(self.sock, return_type='byte')
                decrypted_data = self.AESdec(encrypted_data)
                message = pickle.loads(decrypted_data)

                self.handle_server_message(message)
            except Exception as e:
                print(f"Error receiving message from server: {e}")
                if not self.stop_listening:
                    continue

    def show_connection_error(self):
        """Show connection error dialog and exit"""
        messagebox.showerror("Connection Lost",
                             "Connection to the server has been lost. The application will now close.")
        self.on_closing()

    def handle_server_message(self, message):
        """Process messages received from the server"""
        message_type = message.get('code', '')
        print(f"Received message type: {message_type}")

        if message_type == 'notification':
            # Show notification to user
            content = message.get('content', '')
            self.after(0, lambda c=content: self.show_notification(c))
            self.after(0, lambda c=content: self.add_activity_to_list(c))

        elif message_type == 'update_apps':
            self.after(0, lambda: self.update_blocked_apps_list(message.get('apps', [])))

        elif message_type == 'update_children_status':
            self.after(0, lambda: self.update_children_status(message.get('children', [])))

        elif message_type == 'children_status_update':
            self.after(0, lambda: self.process_children_status_update(message.get('children', [])))

    def process_children_status_update(self, children_data):
        """Process the children status update from server"""
        if not children_data:
            return

        # Update the child_time_data dictionary with current values
        for child in children_data:
            username = child["username"]
            is_connected = child.get("connected", False)

            if "used_time" in child and "time_limit" in child:
                used_time = child["used_time"]  # in minutes
                time_limit = child["time_limit"]  # in minutes

                # Convert minutes to hours and minutes for display
                used_hours = int(used_time // 60)
                used_minutes = int(used_time % 60)
                limit_hours = int(time_limit // 60)
                limit_minutes = int(time_limit % 60)

                # Update the data store
                if username in self.child_time_data:
                    self.child_time_data[username].update({
                        "used_hours": used_hours,
                        "used_minutes": used_minutes,
                        "limit_hours": limit_hours,
                        "limit_minutes": limit_minutes,
                        "connected": is_connected
                    })
                else:
                    self.child_time_data[username] = {
                        "used_hours": used_hours,
                        "used_minutes": used_minutes,
                        "limit_hours": limit_hours,
                        "limit_minutes": limit_minutes,
                        "connected": is_connected
                    }

            # Make sure we have the child in our names list
            if username not in self.children_names:
                self.children_names.append(username)
                # Update the child selection dropdown if it exists
                if hasattr(self, 'child_dropdown') and self.child_dropdown:
                    self.child_dropdown.configure(values=self.children_names)

        # If the current child is in the update, refresh the display
        if hasattr(self, 'current_child') and self.current_child in self.child_time_data:
            self.update_time_display()

        # Also update the overview tab with connection status
        self.update_children_status_display(children_data)

    def update_children_status_display(self, children_data):
        """Update the children status display in the overview tab"""
        # Find the status frame in the overview tab
        for widget in self.tab_overview.winfo_children():
            if isinstance(widget, ctk.CTkFrame):
                # Look for the status frame - it has the "Children Status" label
                for child_widget in widget.winfo_children():
                    if isinstance(child_widget, ctk.CTkLabel) and "Children Status" in child_widget.cget("text"):
                        # This is the status frame - clear existing children
                        for label in widget.winfo_children():
                            if isinstance(label, ctk.CTkLabel) and "•" in label.cget("text"):
                                label.destroy()

                        # Add updated status
                        for child_data in children_data:
                            username = child_data.get("username", "Unknown")
                            status = "Connected" if child_data.get("connected", False) else "Disconnected"

                            status_text = f"{username} - {status}"

                            # Add time info if available
                            if "used_time" in child_data and "time_limit" in child_data:
                                used_time = child_data["used_time"]
                                time_limit = child_data["time_limit"]
                                percentage = min(100, int((used_time / time_limit) * 100)) if time_limit > 0 else 0
                                status_text += f" - Time: {int(used_time)} min / {int(time_limit)} min ({percentage}%)"

                            # Create and pack the label
                            child_label = ctk.CTkLabel(widget, text=f"• {status_text}")
                            child_label.pack(anchor="w", padx=30, pady=2)

                        return

    def on_closing(self):
        """Handle window close event"""
        # Set the flag to stop listening thread
        self.stop_listening = True

        # Send exit request to server
        self.exitReq()

        # Close the window
        self.quit()
        self.destroy()
        sys.exit()

    def AESenc(self, data, k=None):
        """Encrypt data using AES"""
        if k is None:
            k = key
        iv = get_random_bytes(AES.block_size)  # Generate a random IV
        cipher = AES.new(k, AES.MODE_CBC, iv=iv)
        ciphertext = cipher.encrypt(pad(data, AES.block_size))
        return iv + ciphertext  # Prepend IV to the ciphertext for later use in decryption

    def AESdec(self, data, k=None):
        """Decrypt data using AES"""
        if k is None:
            k = key
        iv = data[:AES.block_size]  # Extract IV from the beginning of the ciphertext
        cipher = AES.new(k, AES.MODE_CBC, iv=iv)
        decrypted = unpad(cipher.decrypt(data[AES.block_size:]), AES.block_size)
        return decrypted

    def exitReq(self):
        """Send exit request to server"""
        try:
            global key
            login_dict = {
                "code": 'exit',
            }
            data = pickle.dumps(login_dict)
            data = self.AESenc(data, key)
            send_with_size(self.sock, data)
        except Exception as e:
            print(f"Error sending exit request: {e}")

