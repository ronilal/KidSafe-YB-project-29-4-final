def login(request_dict, sock):
    username = request_dict['user']
    password = request_dict['password']

    print(f"Login attempt for user: '{username}'")

    # Make sure we can access the database
    if not os.path.exists('userData.db'):
        print("ERROR: Database file not found!")
        status = False
        role = None
    else:
        try:
            conn = sqlite3.connect('userData.db', timeout=10)  # Add timeout
            cursor = conn.cursor()

            # Debug - print all users
            cursor.execute("SELECT username, role FROM users")
            all_users = cursor.fetchall()
            print(f"All users in DB: {all_users}")

            # Try to find this specific user
            cursor.execute("SELECT password_hash, salt, role, user_id FROM users WHERE username = ?", (username,))
            result = cursor.fetchone()

            print(f"Query result for '{username}': {result}")

            if result:
                stored_hash, salt, role, user_id = result
                hashed_password = bcrypt.hashpw(password.encode(), salt)

                # Check if the entered password matches the stored hash
                if hashed_password == stored_hash:
                    # Update the last login time
                    cursor.execute("UPDATE users SET last_login = CURRENT_TIMESTAMP WHERE username = ?",
                                   (username,))
                    conn.commit()
                    status = True
                    print(f"Login successful for {username}, role: {role}")

                    # Register the user as connected based on role
                    if role == "Parent":
                        register_connected_parent(user_id, sock)
                    elif role == "Child":
                        register_connected_child(user_id, sock)
                else:
                    status = False
                    print("Password mismatch")
            else:
                status = False
                role = None
                print(f"User '{username}' not found")

        except sqlite3.Error as e:
            print(f"SQLite error: {e}")
            status = False
            role = None

        except Exception as e:
            print(f"Unexpected error: {e}")
            status = False
            role = None

        finally:
            if 'conn' in locals():
                conn.close()

    # Send response
    response_dict = {
        "code": "login",
        "status": status,
        "role": role
    }

    data = pickle.dumps(response_dict)
    data = AESenc(data)
    send_with_size(sock, data)

    # Return success indicator for the client handler
    return "success" if status else None


