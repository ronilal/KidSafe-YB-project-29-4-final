def generate_random_key(length):
    """Generate a random key of specified length"""
    return secrets.token_bytes(length)


def RSA(sock):
    """Perform RSA key exchange with client"""
    global key
    public_key1 = int.from_bytes(generate_random_key(16), byteorder='big')
    send_with_size(sock, str(public_key1).encode())
    public_key2 = int(recv_by_size(sock, return_type='byte').decode())
    print(f"Received key from client")

    secret_key = int.from_bytes(generate_random_key(16), byteorder='big')
    print(f"Generated secret key")

    p = pow(public_key2, secret_key, public_key1)
    send_with_size(sock, str(p).encode())

    b = int(recv_by_size(sock, return_type='byte').decode())
    a = pow(b, secret_key, public_key1)
    key = int_to_bytes(a)
    print(f"Completed key exchange, encryption key established")


def int_to_bytes(x: int, length: int = None, byteorder: str = 'big') -> bytes:
    """Convert integer to bytes"""
    if length is None:
        length = (x.bit_length() + 7) // 8
    return x.to_bytes(length, byteorder)


def check_client_connections():
    """Periodic task to check for stale connections and update used time"""
    while True:
        try:
            current_time = time.time()

            # Check for disconnected children
            disconnected_children = []
            for child_id, data in connected_children.items():
                # If we haven't received a message in 5 minutes, consider disconnected
                if "last_activity" in data and current_time - data.get("last_activity", 0) > 300:
                    disconnected_children.append(child_id)

            # Process any disconnected children
            for child_id in disconnected_children:
                unregister_child(child_id)

            # Update used time for all connected children
            for child_id, data in connected_children.items():
                connected_time = data["connected_time"]
                session_duration = (current_time - connected_time) / 60  # in minutes

                # Update the database every 5 minutes to avoid excessive writes
                if "last_update" not in data or current_time - data.get("last_update", 0) > 300:
                    total_time = data["used_time"] + session_duration
                    update_accumulated_time_in_db(child_id, total_time)
                    connected_children[child_id]["last_update"] = current_time
                    print(f"Updated used time for child {child_id}: {total_time:.1f} minutes")

            # Sleep for 1 minute before next check
            time.sleep(60)

        except Exception as e:
            print(f"Error in check_client_connections: {e}")
            time.sleep(30)  # Wait before retry


