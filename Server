            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY AUTOINCREMENT,
                username TEXT UNIQUE NOT NULL,
                password_hash BLOB NOT NULL,
                salt BLOB NOT NULL,
                email TEXT UNIQUE NOT NULL,
                role TEXT NOT NULL,
                account_created TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                last_login TIMESTAMP,
                is_active INTEGER DEFAULT 1,
                preferences TEXT,
                limit_settings TEXT
            )
        """)

        # Create relationships table if not exists
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS relationships (
                relationship_id INTEGER PRIMARY KEY AUTOINCREMENT,
                parent_id INTEGER NOT NULL,
                child_id INTEGER NOT NULL,
                FOREIGN KEY (parent_id) REFERENCES users(user_id),
                FOREIGN KEY (child_id) REFERENCES users(user_id),
                UNIQUE(parent_id, child_id)
            )
        """)

        # Create blocked_apps table if not exists
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS blocked_apps (
                blocked_apps_id INTEGER PRIMARY KEY AUTOINCREMENT,
                child_id INTEGER NOT NULL,
                app_names TEXT,  -- JSON array of app names
                date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (child_id) REFERENCES users(user_id)
            )
        """)

        # Create blocked_websites table if not exists
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS blocked_websites (
                blocked_websites_id INTEGER PRIMARY KEY AUTOINCREMENT,
                child_id INTEGER NOT NULL,
                domains TEXT,  -- JSON array of domains
                date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (child_id) REFERENCES users(user_id)
            )
        """)

        # Create time_limits table if not exists
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS time_limits (
                time_limit_id INTEGER PRIMARY KEY AUTOINCREMENT,
                child_id INTEGER NOT NULL,
                time_limit INTEGER DEFAULT 1440,  -- Default to 24 hours (1440 minutes)
                used_time REAL DEFAULT 0,
                date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (child_id) REFERENCES users(user_id)
            )
        """)

        # Create activity_log table if not exists
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS activity_log (
                log_id INTEGER PRIMARY KEY AUTOINCREMENT,
                child_id INTEGER NOT NULL,
                activity_type TEXT NOT NULL,  -- e.g., 'app_blocked', 'website_blocked', 'time_limit_reached'
                details TEXT,  -- Additional details about the activity
                timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (child_id) REFERENCES users(user_id)
            )
        """)

        conn.commit()
        print("Database setup completed successfully")
        return True

    except sqlite3.Error as e:
        print(f"Database setup error: {e}")
        return False
    finally:
        if 'conn' in locals():
            conn.close()


if __name__ == '__main__':
    # Ensure database is set up properly
    print("Starting server on port 6108...")
    # Start the server
    main(6112)
