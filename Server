def register_activity(child_id, activity_type, details=None):
    """Log an activity for a child"""
    try:
        conn = sqlite3.connect('userData.db')
        cursor = conn.cursor()

        cursor.execute("""
            INSERT INTO activity_log (child_id, activity_type, details)
            VALUES (?, ?, ?)
        """, (child_id, activity_type, details))

        conn.commit()
        conn.close()

        # Notify parents about the activity
        child_username = get_username_for_child_id(child_id)
        notification_text = f"{child_username}: {activity_type}"
        if details:
            notification_text += f" - {details}"

        # Get parent IDs for this child
        parent_ids = get_parent_ids_for_child(child_id)

        # Prepare notification
        notification = {
            "code": "notification",
            "content": notification_text
        }

        # Send to each connected parent
        for parent_id in parent_ids:
            if parent_id in connected_parents:
                try:
                    data = pickle.dumps(notification)
                    data = AESenc(data)
                    send_with_size(connected_parents[parent_id]["sock"], data)
                except Exception as e:
                    print(f"Failed to notify parent {parent_id}: {e}")

        return True
    except Exception as e:
        print(f"Error logging activity: {e}")
        return False


def get_activity_logs(child_id, limit=20):
    """Get recent activity logs for a child"""
    try:
        conn = sqlite3.connect('userData.db')
        cursor = conn.cursor()

        cursor.execute("""
            SELECT activity_type, details, timestamp
            FROM activity_log 
            WHERE child_id = ?
            ORDER BY timestamp DESC
            LIMIT ?
        """, (child_id, limit))

        logs = cursor.fetchall()
        conn.close()

        # Format logs for easy consumption
        formatted_logs = []
        for log in logs:
            activity_type, details, timestamp = log
            formatted_logs.append({
                "type": activity_type,
                "details": details,
                "timestamp": timestamp
            })

        return formatted_logs
    except Exception as e:
        print(f"Error getting activity logs: {e}")
        return []


def check_time_limits():
    """Check time limits for all connected children and enforce if needed"""
    for child_id, data in list(connected_children.items()):  # Use list to avoid modification during iteration
        try:
            # Calculate current session time
            current_time = time.time()
            connected_time = data["connected_time"]
            session_duration = (current_time - connected_time) / 60  # in minutes
            total_time = data["used_time"] + session_duration

            # Get time limit
            time_limit = get_time_limit_for_child(child_id)

            # Check if limit is exceeded
            if total_time >= time_limit:
                child_username = get_username_for_child_id(child_id)
                print(f"Time limit reached for child {child_username}")

                # Log the activity
                register_activity(child_id, "time_limit_reached",
                                  f"Used: {total_time:.1f} minutes, Limit: {time_limit} minutes")

                # Notify the child
                if "sock" in data:
                    try:
                        notification = {
                            "code": "time_limit_reached",
                            "message": "Your screen time limit has been reached."
                        }

                        notif_data = pickle.dumps(notification)
                        notif_data = AESenc(notif_data)
                        send_with_size(data["sock"], notif_data)
                    except Exception as e:
                        print(f"Error notifying child {child_id}: {e}")
        except Exception as e:
            print(f"Error checking time limit for child {child_id}: {e}")


# Update the status_update_manager to include time limit checks
def status_update_manager():
    """Thread that sends periodic updates to connected parent clients and checks time limits"""
    update_interval = 30  # seconds between updates
    last_time_check = 0

    while True:
        try:
            current_time = time.time()

            # Check time limits every minute
            if current_time - last_time_check >= 60:
                check_time_limits()
                last_time_check = current_time

            # Get all parent sockets that need updates
            parents_to_update = get_connected_parents()

            # Process each parent client
            for parent_id, sock in parents_to_update.items():
                try:
                    # Generate status update for this parent
                    children_status = generate_children_status_for_parent(parent_id)

                    # Send the update
                    response = {
                        "code": "children_status_update",
                        "status": True,
                        "children": children_status
                    }

                    data = pickle.dumps(response)
                    data = AESenc(data)
                    send_with_size(sock, data)
                except Exception as e:
                    print(f"Error updating parent {parent_id}: {e}")

            # Sleep for the update interval
            time.sleep(update_interval)
        except Exception as e:
            print(f"Error in status update manager: {e}")
            time.sleep(5)  # Brief pause before retry if there's an error


def get_connected_parents():
    """Return a dictionary of connected parent IDs and their sockets"""
    # Could add filtering here to only include parents who need updates
    return {parent_id: data["sock"] for parent_id, data in connected_parents.items()}


def generate_children_status_for_parent(parent_id):
    """Generate status updates for all children of a parent"""
    # Get all children IDs for this parent
    children_ids = get_children_ids_for_parent(parent_id)

    children_status = []
    for child_id in children_ids:
        child_username = get_username_for_child_id(child_id)
        is_connected = child_id in connected_children

        if is_connected:
            # Calculate current session time
            current_session = (time.time() - connected_children[child_id]["connected_time"]) / 60  # in minutes
            total_time = connected_children[child_id]["used_time"] + current_session
        else:
            # Get time from database
            total_time = get_accumulated_time_from_db(child_id)

        # Get time limit
        time_limit = get_time_limit_for_child(child_id)

        children_status.append({
            "username": child_username,
            "connected": is_connected,
            "used_time": total_time,
            "time_limit": time_limit
        })

    return children_status


