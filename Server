    global key
    RSA(sock)

    # Variables to track client identity
    client_id = None
    client_type = None  # "parent" or "child"

    while True:
        try:
            client_msg_encrypted = recv_by_size(sock, return_type='byte')  # Receive encrypted message from client
            client_msg = AESdec(client_msg_encrypted)  # Decrypt the message
            client_msg = pickle.loads(client_msg)  # load the pickle file to dict

            # Process the message
            result = handle_req(client_msg, sock)

            # Check if it's a login request to store user identity
            if client_msg['code'] == 'login' and result == "success":
                username = client_msg['user']
