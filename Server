def link_parent(request_dict, sock):
    child_username = request_dict['child_username']
    parent_username = request_dict['parent_username']

    # Get IDs from usernames
    child_id = get_user_id(child_username)
    parent_id = get_user_id(parent_username)

    if not child_id or not parent_id:
        print(f"Child '{child_username}' or parent '{parent_username}' not found")
        return False

    try:
        conn = sqlite3.connect('userData.db')
        cursor = conn.cursor()

        # Check if the parent already has other children
        cursor.execute("SELECT child_id FROM relationships WHERE parent_id = ?", (parent_id,))
        existing_children = cursor.fetchall()

        # Create the relationship between parent and new child
        cursor.execute("""
                    INSERT INTO relationships (parent_id, child_id)
                    VALUES (?, ?)
                """, (parent_id, child_id))

        empty_json = json.dumps([])

        # Insert into blocked_websites if not exists
        cursor.execute("SELECT 1 FROM blocked_websites WHERE child_id = ?", (child_id,))
        if not cursor.fetchone():
            cursor.execute("""
                INSERT INTO blocked_websites (child_id, domains, date_added)
                VALUES (?, ?, CURRENT_TIMESTAMP)
            """, (child_id, empty_json))
            print('Added entry in blocked_websites table')

        # Insert into blocked_apps if not exists
        cursor.execute("SELECT 1 FROM blocked_apps WHERE child_id = ?", (child_id,))
        if not cursor.fetchone():
            cursor.execute("""
                INSERT INTO blocked_apps (child_id, app_names, date_added)
                VALUES (?, ?, CURRENT_TIMESTAMP)
            """, (child_id, empty_json))
            print('Added entry in blocked_apps table')

        # Insert into time_limits if not exists
        cursor.execute("SELECT 1 FROM time_limits WHERE child_id = ?", (child_id,))
        if not cursor.fetchone():
            cursor.execute("""
                INSERT INTO time_limits (child_id, time_limit, used_time)
                VALUES (?, ?, ?)
            """, (child_id, 1440, 0))
            print('Added entry in time_limits table')

        # If parent has existing children, copy block settings from the first one
        if existing_children:
            previous_child_id = existing_children[0][0]
            print(f"Parent has existing children. Using settings from child_id: {previous_child_id}")

            # Copy blocked apps settings
            previous_apps = get_blocked_apps_for_child(previous_child_id)
            if previous_apps:
                update_blocked_apps_for_child(child_id, previous_apps)
                print(f"Copied blocked apps to new child: {previous_apps}")

            # Copy blocked websites settings
            previous_domains = get_blocked_domains_for_child(previous_child_id)
            if previous_domains:
                update_blocked_domains_for_child(child_id, previous_domains)
                print(f"Copied blocked domains to new child: {previous_domains}")

        # Commit the transaction
        conn.commit()
        print(f"Successfully linked parent '{parent_username}' to child '{child_username}'")
        return True

    except sqlite3.Error as e:
        print(f"Database error in link_parent: {str(e)}")
        if conn:
            conn.rollback()
        return False

    except Exception as e:
        print(f"Unexpected error in link_parent: {str(e)}")
        if conn:
            conn.rollback()
        return False

    finally:
        if 'conn' in locals() and conn:
            conn.close()


def block_app(request, sock):
    print('in block_app')

    try:
        # Getting the data from the client
        username = request.get("username")
        app_name = request.get("app_name")

        # Check if required fields are present
        if not username or not app_name:
            print("Error: Missing username or app_name in request")
            return False

        # Get parent ID
        parent_id = get_user_id(username)
        if not parent_id:
            print(f"Error: User '{username}' not found")
            return False

        print(f'user id for {username} is - {parent_id}')

        # Get children IDs
        children_ids = get_children_ids_for_parent(parent_id)
        if not children_ids:
            print(f"Parent '{username}' has no registered children")
            return True

        print(f"Children IDs: {children_ids}")

        for child_id in children_ids:
            print(f'Processing child ID: {child_id}')

            # Get current blocked apps
            app_names = get_blocked_apps_for_child(child_id)

            # Check if app is already blocked
            if app_name in app_names:
                print(f"App '{app_name}' is already blocked for child_id '{child_id}'")
                continue  # Skip to next child

            # Add the app to blocked list
            app_names.append(app_name)

            # Update the database
            update_blocked_apps_for_child(child_id, app_names)

        return True

    except Exception as e:
