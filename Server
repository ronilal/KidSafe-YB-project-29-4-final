# ================ Connection Management Functions ================

def register_connected_parent(parent_id, sock):
    """Register a parent as connected when they log in"""
    connected_parents[parent_id] = {
        "sock": sock,
        "last_update": time.time()
    }
    print(f"Parent {parent_id} registered as connected")


def register_connected_child(child_id, sock):
    """Register a child as connected when they log in"""
    # Get previous used time from database
    previous_time = get_accumulated_time_from_db(child_id)

    connected_children[child_id] = {
        "sock": sock,
        "connected_time": time.time(),
        "used_time": previous_time
    }

    print(f"Child {child_id} registered as connected")

    # Notify all relevant parents
    notify_parents_of_child_connection(child_id, True)


def unregister_child(child_id):
    """Handle child disconnection"""
    if child_id in connected_children:
        # Calculate session duration
        session_duration = (time.time() - connected_children[child_id]["connected_time"]) / 60  # in minutes
        total_time = connected_children[child_id]["used_time"] + session_duration

        # Update database
        update_accumulated_time_in_db(child_id, total_time)

        # Remove from tracking
        del connected_children[child_id]

        print(f"Child {child_id} unregistered")

        # Notify parents
        notify_parents_of_child_connection(child_id, False)


def unregister_parent(parent_id):
    """Handle parent disconnection"""
    if parent_id in connected_parents:
        del connected_parents[parent_id]
        print(f"Parent {parent_id} unregistered")


def notify_parents_of_child_connection(child_id, is_connected):
    """Notify all parents of a child about connection status change"""
    # Get parent IDs for this child
    parent_ids = get_parent_ids_for_child(child_id)
    child_username = get_username_for_child_id(child_id)

    status_text = "connected" if is_connected else "disconnected"

    # Prepare notification
    notification = {
        "code": "notification",
        "content": f"{child_username} has {status_text} at {time.strftime('%H:%M:%S')}"
    }

    # Send to each connected parent
    for parent_id in parent_ids:
        if parent_id in connected_parents:
            try:
                data = pickle.dumps(notification)
                data = AESenc(data)
                send_with_size(connected_parents[parent_id]["sock"], data)
            except Exception as e:
                print(f"Failed to notify parent {parent_id}: {e}")


