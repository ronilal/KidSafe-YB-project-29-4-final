def status_update_manager():
    """Thread that sends periodic updates to connected parent clients and checks time limits"""
    update_interval = 30  # seconds between updates
    last_time_check = 0

    while True:
        try:
            current_time = time.time()

            # Check time limits every minute
            if current_time - last_time_check >= 60:
                check_time_limits()
                last_time_check = current_time

            # Get all parent sockets that need updates
            parents_to_update = get_connected_parents()

            # Process each parent client
            for parent_id, sock in parents_to_update.items():
                try:
                    # Generate status update for this parent
                    children_status = generate_children_status_for_parent(parent_id)

                    # Send the update
                    response = {
                        "code": "children_status_update",
                        "status": True,
                        "children": children_status
                    }

                    data = pickle.dumps(response)
                    data = AESenc(data)
                    send_with_size(sock, data)
                except Exception as e:
                    print(f"Error updating parent {parent_id}: {e}")

            # Sleep for the update interval
            time.sleep(update_interval)
        except Exception as e:
            print(f"Error in status update manager: {e}")
            time.sleep(5)  # Brief pause before retry if there's an error


def main(port):
    """
    main server loop
    1. accept tcp connection
    2. create thread for each connected new client
    3. start status update manager for real-time updates
    4. start connection monitor thread
    """
    # Start the status update manager thread
    update_thread = threading.Thread(target=status_update_manager, daemon=True)
    update_thread.start()
    print("Status update manager started")

    # Start the connection monitor thread
    monitor_thread = threading.Thread(target=check_client_connections, daemon=True)
    monitor_thread.start()
    print("Connection monitor started")

    # Create server socket
    srv_sock = socket.socket()
    srv_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)  # Allow address reuse
    srv_sock.bind(('0.0.0.0', port))
    srv_sock.listen(20)

    print(f"Server started on port {port}")

    i = 1
    while True:
        try:
            print('\nMain thread: waiting for connections...')
            cli_sock, addr = srv_sock.accept()
            print(f"Client {i} connected from {addr}")
            t = threading.Thread(target=handle_client, args=(cli_sock, str(i), addr))
            t.start()
            i += 1

            # Safety exit condition (for testing)
            if i > 100000000:  # for tests change it to a lower number
                print('\nMain thread: going down for maintenance')
                break

        except KeyboardInterrupt:
            print("\nServer shutdown requested...")
            break
        except Exception as e:
            print(f"Error accepting connections: {e}")
            time.sleep(1)  # Brief pause before retry

    print("Server shutting down...")
    try:
        srv_sock.close()
    except:
        pass


