def get_accumulated_time_from_db(child_id):
    """Get accumulated screen time for a child"""
    try:
        conn = sqlite3.connect('userData.db')
        cursor = conn.cursor()
        cursor.execute("SELECT used_time FROM time_limits WHERE child_id = ?", (child_id,))
        result = cursor.fetchone()
        conn.close()
        # Always return 0 if NULL or not found
        return result[0] if result and result[0] is not None else 0
    except Exception as e:
        print(f"Error getting accumulated time: {e}")
        return 0


def update_accumulated_time_in_db(child_id, total_time):
    """Update the accumulated screen time for a child"""
    try:
        conn = sqlite3.connect('userData.db')
        cursor = conn.cursor()
        cursor.execute("UPDATE time_limits SET used_time = ? WHERE child_id = ?", (total_time, child_id))
        if cursor.rowcount == 0:
            # If no row was updated, insert a new one
            cursor.execute("INSERT INTO time_limits (child_id, used_time) VALUES (?, ?)", (child_id, total_time))
        conn.commit()
        conn.close()
        return True
    except Exception as e:
        print(f"Error updating accumulated time: {e}")
        return False


